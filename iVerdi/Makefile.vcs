# ============================================================================
# VCS Simulation Makefile for RISC-V / NPU SoC (Coverage Regression Edition)
# ============================================================================

# ----------------------------------------------------------------------------
# 1. 动态获取工程根目录与工作区划定
# ----------------------------------------------------------------------------
CUR_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
PROJ_ROOT := $(abspath $(CUR_DIR)/..)
export PROJ_ROOT

# 工作目录设置 (所有编译产物隔离，保持源码干净)
WORK_DIR  := $(CUR_DIR)/vcs_work

# [新增] 回归测试专属固件目录
FW_DIR    := $(CUR_DIR)/regress/firmwares

$(info [INFO] Auto-detected PROJ_ROOT: $(PROJ_ROOT))

# ----------------------------------------------------------------------------
# 2. 动态文件列表与 Top 模块选择
# ----------------------------------------------------------------------------
CASE ?= 1

SRC_ROOT_NPU = $(PROJ_ROOT)/npu_rtl

# [配置 1] PicoRV32 SoC 完整仿真 (默认)
SRC_FILES_1 = $(PROJ_ROOT)/picorv32.v \
              $(SRC_ROOT_NPU)/pe.v \
              $(SRC_ROOT_NPU)/act_skew_buffer.v \
              $(SRC_ROOT_NPU)/sa.v \
              $(SRC_ROOT_NPU)/my_icg.v \
              $(SRC_ROOT_NPU)/npu_bottom_acc.v \
              $(SRC_ROOT_NPU)/npu_ppu.v \
              $(SRC_ROOT_NPU)/npu_deskew_buffer.v \
              $(SRC_ROOT_NPU)/npu_sync_fifo.v \
              $(SRC_ROOT_NPU)/npu_line_buffer.v \
              $(SRC_ROOT_NPU)/npu_axi_wrapper_burst.v \
              $(SRC_ROOT_NPU)/axi_sram.v \
              $(SRC_ROOT_NPU)/axi_interconnect.v \
              $(SRC_ROOT_NPU)/arbiter.v \
              $(SRC_ROOT_NPU)/priority_encoder.v \
              $(SRC_ROOT_NPU)/axi_dp_sram_hybrid.v \
              $(SRC_ROOT_NPU)/tb_picorv32.v
TB_TOP_1    = tb_picorv32
FSDB_NAME_1 = picorv32_soc.fsdb

SRC_FILES = $(SRC_FILES_$(CASE))
TB_TOP    = $(TB_TOP_$(CASE))
FSDB_NAME = $(FSDB_NAME_$(CASE))

# 防呆设计
ifeq ($(strip $(SRC_FILES)),)
$(error "错误: 未知的仿真用例 CASE=$(CASE)！请指定 1~4")
endif

# ----------------------------------------------------------------------------
# 3. 固件回归列表 (Firmware Regression List)
# ----------------------------------------------------------------------------
# 在这里填入你所有的测试固件名字 (会自动去 FW_DIR 目录下寻找它们)
FIRMWARES = firmware_byte_cpu_alu.hex \
            firmware_byte_axi_cfg.hex \
            firmware_byte_axi_burst_edge.hex \
            firmware_byte_math_ones.hex \
            firmware_byte_dim_stretch.hex \
            firmware_byte_fc_reshape.hex \
            firmware_byte_conv_1x1.hex \
            firmware_byte_bus_stress.hex \
            firmware_byte_quant_bound.hex \
            firmware_byte_irq_storm.hex \
            firmware_byte_vgg_full.hex

# ----------------------------------------------------------------------------
# 4. VCS 编译参数 (Compile Flags)
# ----------------------------------------------------------------------------
VCS_FLAGS := -full64 -sverilog
VCS_FLAGS += -timescale=1ns/1ps
VCS_FLAGS += -debug_access+all  # Verdi 调试必备权限
VCS_FLAGS += -kdb -lca          # 开启 KDB
VCS_FLAGS += -top $(TB_TOP)
VCS_FLAGS += -Mdir=csrc
VCS_FLAGS += -o simv
VCS_FLAGS += -l compile.log

# 多核极速编译与 O2 优化
VCS_FLAGS += -j8 -O2

# ----------------------------------------------------------------------------
# 5. 仿真执行参数 (Simulation Flags)
# ----------------------------------------------------------------------------
SIM_FLAGS := -l sim.log
SIM_FLAGS += +fsdb+mda 
SIM_FLAGS += +fsdbfile+$(FSDB_NAME)  
SIM_FLAGS += -no_save

# ============================================================================
# 【核心隔离】：仅当 COV=1 时，才注入沉重的覆盖率收集 Flag！
# ============================================================================
ifeq ($(COV), 1)
VCS_FLAGS += -cm line+tgl+cond+fsm+branch
SIM_FLAGS += -cm line+tgl+cond+fsm+branch
endif

ifeq ($(CHECK), 1)
VCS_FLAGS += +define+SIM_CHECKS
endif

# ----------------------------------------------------------------------------
# 6. 执行目标 (Targets)
# ----------------------------------------------------------------------------
.PHONY: all prepare compile sim wave clean check regress

all: compile sim wave

prepare:
	@mkdir -p $(WORK_DIR)

# 编译
compile: prepare
	@echo "================================================="
	@echo "  [1/3] Starting VCS Compilation (COV=$(COV))"
	@echo "================================================="
	cd $(WORK_DIR) && vcs $(VCS_FLAGS) $(SRC_FILES)

# 单次仿真 (默认寻找工程根目录下的 firmware.hex 进行单次极速调试，不开启覆盖率)
sim:
	@echo "================================================="
	@echo "  [2/3] Running Single Simulation & Dumping FSDB"
	@echo "================================================="
	@ln -sf $(CUR_DIR)/firmware.hex $(WORK_DIR)/ 
	cd $(WORK_DIR) && ./simv $(SIM_FLAGS)

# 后台呼出 Verdi
wave:
	@echo "================================================="
	@echo "  [3/3] Opening Waveform in Verdi"
	@echo "================================================="
	cd $(WORK_DIR) && verdi -dbdir simv.daidir -ssf $(FSDB_NAME) &

# ============================================================================
# 自动化回归与覆盖率合并 (make regress)
# ============================================================================
# 注意：regress 不再直接依赖 compile，而是利用嵌套 make 强制开启 COV=1 重新编译
regress:
	@echo "================================================="
	@echo "  🚀 Re-compiling RTL with Coverage Instrumentation"
	@echo "================================================="
	@$(MAKE) compile COV=1 -f Makefile.vcs
	@echo "================================================="
	@echo "  🚀 Starting Firmware Regression Testing"
	@echo "================================================="
	@for fw in $(FIRMWARES); do \
		echo "-------------------------------------------------"; \
		echo " ▶️ Running Test: $$fw"; \
		echo "-------------------------------------------------"; \
		ln -sf $(FW_DIR)/$$fw $(WORK_DIR)/$$fw; \
		cd $(WORK_DIR) && ./simv $(SIM_FLAGS) -cm_name $$fw +FW=$$fw; \
	done
	@echo "================================================="
	@echo "  📊 Merging Coverage and Generating HTML Report"
	@echo "================================================="
	cd $(WORK_DIR) && urg -dir simv.vdb -format html -report urgReport
	@echo "🎉 Regression Finished!"
	@echo "👉 Please open: $(WORK_DIR)/urgReport/dashboard.html"

check: prepare
	@$(MAKE) compile CHECK=1

clean:
	@echo "--- Cleaning Workspace ---"
	rm -rf $(WORK_DIR)